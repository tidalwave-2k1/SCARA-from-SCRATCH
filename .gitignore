# ---------------------------------------------------------
# Vivado project lives here; rebuilt from scripts/create_project.tcl
# ---------------------------------------------------------
build/

# ---------------------------------------------------------
# Safety net: Vivado files that can land outside build/
# (e.g., logs/journals written to the directory Vivado was launched from)
# ---------------------------------------------------------
*.jou
*.log
*.str
*.debug
.Xil/

# Generated project folders
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/

# Generated design outputs
*.dcp
*.vds
*.vdi
*.wdf
*.pb
*.hwdef

# Bitstreams: ignored by default. Attach releases on GitHub instead,
# or remove this line if you want to commit specific .bit files.
*.bit

# ---------------------------------------------------------
# OS / editor clutter
# ---------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
.vscode/